{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["./shared/*"],
      "@main/*": ["./electron/main/*"],
      "@assets/*": ["./assets/*"]
    }
  },
  "include": [
    "./src/**/*",
    "./shared/**/*",
    "./electron/main/**/*",
    "./assets/**/*"
  ]
}
